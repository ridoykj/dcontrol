root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,mjs,json,yaml,yml,css,html,md}]
indent_size = 2

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

[{mvnw.cmd,gradlew.bat}]
end_of_line = crlf
