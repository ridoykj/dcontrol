<!-- Release: HTTPS/WSS only. The debug source set overrides this file to allow cleartext for local controllers. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
