<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone tab of the web UI. The owner accepts an on-device prompt every session (never auto-accepted),
         and capture runs under an ongoing notification with Stop, so the system microphone indicator stays lit. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application>
        <service
            android:name=".service.MicCaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <activity
            android:name=".service.MicConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DControl.MicConsent" />
    </application>

</manifest>
