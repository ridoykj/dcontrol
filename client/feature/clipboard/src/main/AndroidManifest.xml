<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Translucent and short-lived: reads the clipboard once it has window focus, then finishes.
             Not exported; the intent filter only serves the connection notification's action (same app). -->
        <activity
            android:name=".ui.ClipboardSendActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DControl.ClipboardSend">
            <intent-filter>
                <action android:name="com.dcontrol.client.action.SEND_CLIPBOARD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- BIND_QUICK_SETTINGS_TILE is held by the system UI only. -->
        <service
            android:name=".ui.ClipboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_clipboard"
            android:label="@string/clipboard_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
