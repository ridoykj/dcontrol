<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- API 30+: "All files access" special app access, granted by the user in Settings.
         Google Play only allows it for apps whose core feature is file management (declaration form). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- API 26-29: classic runtime storage permissions (requestLegacyExternalStorage is set in :app for API 29). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Transfer progress notifications (runtime on API 33+, requested during onboarding). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

</manifest>
