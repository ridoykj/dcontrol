<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera tab of the web UI. The owner accepts an on-device prompt every session (never auto-accepted), and
         capture runs under an ongoing notification with Stop, so the system camera (and mic) indicators stay lit.
         RECORD_AUDIO + the microphone FGS type are only used when the viewer turns audio on and it is granted. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application>
        <service
            android:name=".service.CameraCaptureService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <activity
            android:name=".service.CameraConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.DControl.CameraConsent" />
    </application>

</manifest>
