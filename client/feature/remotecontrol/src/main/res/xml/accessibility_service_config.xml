<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal capabilities: dispatch gestures and read the focused text field for typing. No feedback and the
     smallest event set, and isAccessibilityTool="false" because this is remote control, not an assistive tool. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/remote_control_service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0" />
